---
/*
  /500 — server error page.
*/
import TreatmentBLayout from "@layouts/TreatmentBLayout.astro";
import "@styles/nb-status.css";
---

<TreatmentBLayout title="Something Went Wrong · bbcre8s" pathname="/500">
<div class="error-wrap">
  <div class="container">
    <div class="error-inner">
      <span class="error-sticker" aria-hidden="true">UH OH</span>
      <span class="error-label">Error 500</span>
      <div class="error-code"><span class="accent">5</span>0<span class="accent">0</span></div>
      <h1 class="error-headline">Something broke on our end.</h1>
      <p class="error-body">That's on us, not you. The page hit an unexpected snag. Give it a moment and try again — and if it keeps happening, reach out and Bella will sort it out.</p>
      <div class="error-actions">
        <a href="#" onclick="location.reload();return false;" class="btn btn-primary">Try Again</a>
        <a href="/" class="btn btn-outline">Back to Home</a>
      </div>
      <div class="error-quicklinks" aria-label="Jump to a section">
        <a class="quicklink" href="/#portfolio">Portfolio</a>
        <a class="quicklink" href="/#services">Services</a>
        <a class="quicklink" href="/#process">Process</a>
        <a class="quicklink" href="/#contact">Contact</a>
      </div>
    </div>
  </div>
</div>
</TreatmentBLayout>
