---
/*
  /thank-you — contact form success page (the Web3Forms redirect target).
*/
import TreatmentBLayout from "@layouts/TreatmentBLayout.astro";
import "@styles/nb-status.css";
---

<TreatmentBLayout title="Message Sent · bbcre8s" pathname="/thank-you">
<div class="error-wrap">
  <div class="container">
    <div class="error-inner">
      <span class="error-sticker" aria-hidden="true">THANKS!</span>
      <span class="error-label">Message Sent</span>
      <div class="error-code"><span class="accent">✓</span></div>
      <h1 class="error-headline">Message received.</h1>
      <p class="error-body">Thanks for reaching out — your project details are on their way to Bella. Expect a personal reply within one business day. In the meantime, take a look around or grab a time to talk it through.</p>
      <div class="error-actions">
        <a href="/" class="btn btn-primary">Back to Home</a>
        <a href="/#contact" class="btn btn-outline">Book a Call</a>
      </div>
      <div class="error-quicklinks" aria-label="While you wait">
        <a class="quicklink" href="/#portfolio">See the Work</a>
        <a class="quicklink" href="/#services">Services</a>
        <a class="quicklink" href="/#process">How It Works</a>
      </div>
    </div>
  </div>
</div>
<style is:global>
body { --page-bg: var(--accent-blush); background: var(--page-bg); }
</style>
</TreatmentBLayout>
